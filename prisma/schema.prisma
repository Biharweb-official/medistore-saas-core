generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String
  entity    String
  entityId  String
  userId    String?
  timestamp DateTime @default(now())
  details   Json?

  @@index([tenantId, timestamp])
  @@index([tenantId, entity, timestamp])
  @@map("audit_logs")
}
